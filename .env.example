# Clave de API de Anthropic. Crear en https://console.anthropic.com → API Keys.
# En Vercel: Project → Settings → Environment Variables → agregar ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo a usar. Por defecto claude-opus-4-7.
# Para más velocidad/menor costo en alto volumen, puedes usar claude-sonnet-4-6.
# CLAUDE_MODEL=claude-opus-4-7
